From 21aa6f0ecf7f84f1419480c05505df7cbe2f0d7b Mon Sep 17 00:00:00 2001
From: Daniel Ching <dching@nvidia.com>
Date: Mon, 8 Sep 2025 13:11:31 -0500
Subject: [PATCH] BUG: Guard against driver failures when testing no-gpu

cuda.pathfinder raises DynamicLibNotFoundError (a RuntimeError) when
libnvidia-ml cannot be found, instead of CUDAError. Without this, test
collection fails on machines without the NVIDIA driver, even for
nvmath-python-cpu tests.
---
 tests/example_tests/test_utils.py | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/tests/example_tests/test_utils.py b/tests/example_tests/test_utils.py
--- a/tests/example_tests/test_utils.py
+++ b/tests/example_tests/test_utils.py
@@ -28,7 +28,8 @@
 
 try:
     DEVICE_COUNT = system.get_num_devices()
-except CUDAError:
+except (CUDAError, RuntimeError):
+    # RuntimeError covers cuda.pathfinder.DynamicLibNotFoundError (NVML/driver not installed)
     DEVICE_COUNT = 0
 
 try:
-- 
2.51.0

